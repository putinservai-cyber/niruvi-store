{
  "name": "niruvi-store",
  "private": true,
  "version": "0.1.0",
  "description": "Verified Linux AppImage software marketplace with SHA-256 checksum verification and one-click niruvi:// desktop installation.",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "validate:catalog": "tsx scripts/validate-catalog.ts && tsx scripts/validate-firestore-rules.ts",
    "validate:rules": "tsx scripts/validate-firestore-rules.ts",
    "generate:catalog": "tsx scripts/generate-catalog.ts",
    "build:catalog": "tsx scripts/validate-catalog.ts && tsx scripts/generate-catalog.ts",
    "build": "node -e \"const fs=require('fs'),cp=require('child_process');if(fs.existsSync('scripts/generate-catalog.ts'))cp.execSync('npx tsx scripts/generate-catalog.ts',{stdio:'inherit'})\" && tsc --noEmit && vite build && node -e \"const fs=require('fs'),cp=require('child_process');if(fs.existsSync('scripts/prerender-static.ts'))cp.execSync('npx tsx scripts/prerender-static.ts',{stdio:'inherit'})\"",
    "build:static": "tsx scripts/generate-catalog.ts && vite build && tsx scripts/prerender-static.ts",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "admin:submissions": "tsx scripts/admin-submissions.ts",
    "lint": "eslint . && tsc --noEmit",
    "lint:fix": "eslint . --fix && prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "test": "NODE_OPTIONS=\"--import ./scripts/vitest-node-shim.mjs\" vitest run",
    "test:watch": "NODE_OPTIONS=\"--import ./scripts/vitest-node-shim.mjs\" vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.2.0",
    "vitest": "^5.0.3",
    "wrangler": "4"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
