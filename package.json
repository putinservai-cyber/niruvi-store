{
  "name": "niruvi-store",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:experimental": "tsx experimental/server.ts",
    "validate:catalog": "tsx scripts/validate-catalog.ts && tsx scripts/validate-firestore-rules.ts",
    "validate:rules": "tsx scripts/validate-firestore-rules.ts",
    "generate:catalog": "tsx scripts/generate-catalog.ts",
    "build:catalog": "tsx scripts/validate-catalog.ts && tsx scripts/generate-catalog.ts",
    "build": "tsx scripts/generate-catalog.ts && vite build",
    "build:static": "tsx scripts/generate-catalog.ts && vite build",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "lint": "eslint . && tsc --noEmit",
    "lint:fix": "eslint . --fix && prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "firebase": "^12.18.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "motion": "^12.4.7",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.0.2",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.2.0",
    "vitest": "^5.0.3",
    "wrangler": "^3.114.0"
  }
}
