rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives (Phase 3)
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validator: User
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'username', 'role'])
        && data.id is string && data.id.size() <= 128
        && data.email is string && data.email.size() <= 128
        && data.username is string && data.username.size() <= 64 && data.username.matches('^[a-zA-Z0-9_]+$')
        && data.role in ['USER', 'DEVELOPER', 'ADMIN']
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 512))
        && (!('firebaseUid' in data) || (data.firebaseUid is string && data.firebaseUid.size() <= 128));
    }

    // Entity Validator: App
    function isValidApp(data) {
      return data.keys().hasAll(['id', 'name', 'version', 'downloadUrl', 'sha256'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 128
        && data.version is string && data.version.size() <= 64
        && data.downloadUrl is string && data.downloadUrl.size() <= 512 && data.downloadUrl.matches('^https?://.*$')
        && data.sha256 is string && data.sha256.size() == 64
        && (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 256))
        && (!('description' in data) || (data.description is string && data.description.size() <= 8192))
        && (!('license' in data) || (data.license is string && data.license.size() <= 64))
        && (!('homepageUrl' in data) || (data.homepageUrl is string && data.homepageUrl.size() <= 512))
        && (!('sourceUrl' in data) || (data.sourceUrl is string && data.sourceUrl.size() <= 512))
        && (!('category' in data) || (data.category is string && data.category.size() <= 64))
        && (!('publisherName' in data) || (data.publisherName is string && data.publisherName.size() <= 128))
        && (!('iconUrl' in data) || (data.iconUrl is string && data.iconUrl.size() <= 512));
    }

    // Entity Validator: Review
    function isValidReview(data) {
      return data.keys().hasAll(['id', 'appId', 'userId', 'rating', 'title', 'body'])
        && data.id is string && data.id.size() <= 128
        && data.appId is string && data.appId.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.title is string && data.title.size() <= 128
        && data.body is string && data.body.size() <= 4096
        && (!('isVerifiedPurchase' in data) || (data.isVerifiedPurchase is bool))
        && (!('createdAt' in data) || (data.createdAt is string));
    }

    // Match users collection
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN');
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming())
        && incoming().role == existing().role; // Forbid self role-escalation!
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // Match apps collection
    match /apps/{appId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(appId) && isValidApp(incoming())
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['DEVELOPER', 'ADMIN']);
      allow update: if isSignedIn() && isValidId(appId) && isValidApp(incoming())
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['DEVELOPER', 'ADMIN']);
      allow delete: if isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN');

      // Match reviews subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidId(reviewId) && isValidReview(incoming()) && incoming().userId == request.auth.uid;
        allow update: if isSignedIn() && isValidId(reviewId) && isValidReview(incoming()) && existing().userId == request.auth.uid && incoming().userId == request.auth.uid;
        allow delete: if isSignedIn() && (existing().userId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN');
      }
    }
  }
}
