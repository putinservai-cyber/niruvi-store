{
  "name": "niruvi-store",
  "main": "src/worker.ts",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "niruvi-store-db",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "NIRUVI_AUTH_KV",
      "id": "00000000000000000000000000000001"
    }
  ],
  "triggers": {
    "crons": ["0 */6 * * *"]
  }
}
