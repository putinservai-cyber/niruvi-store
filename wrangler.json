{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "niruvi-store-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist"
  },
  "kv_namespaces": [
    {
      "binding": "NIRUVI_AUTH_KV",
      "id": "niruvi_auth_kv_store"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "niruvi_store_d1",
      "database_id": "niruvi-store-d1-db"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "JWT_SECRET": "niruvi-linux-appimage-store-secret-2026"
  }
}
