# Niruvi Store — Environment Configuration
# Base path for Vite & GitHub Pages ('/niruvi-store/' for project Pages, '/' for custom domain)
VITE_BASE=/
VITE_SITE_URL=https://niruvi-store.runs-on.dev

# Public Supabase Client Configuration (OAuth PKCE + Row Level Security)
# NEVER put SUPABASE_SERVICE_ROLE_KEY in frontend code or VITE_* variables.
VITE_SUPABASE_URL=https://lenuyuhixujmuaalnkwp.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_public_key_only

# Public Cloudflare Worker API URL & Turnstile Site Key (safe for client bundle)
VITE_API_URL=https://niruvi-store-api.putinservai.workers.dev
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFLO1pJ9suZGgMaE

# Cloudflare Worker Secrets (provision via `npx wrangler secret put <NAME>`; NEVER expose to client)
TURNSTILE_SECRET_KEY=example_dummy_turnstile_secret_key
ADMIN_TOKEN=example_dummy_admin_secret_token
IP_HASH_SALT=example_dummy_ip_hash_salt
GITHUB_TOKEN=ghp_example_dummy_token_for_github_releases_api
JWT_SECRET=example_dummy_jwt_secret_replace_in_wrangler
OAUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
OAUTH_CLIENT_SECRET=example_dummy_oauth_client_secret_never_expose

# Optional local development variables
PORT=3000
NODE_ENV=development
