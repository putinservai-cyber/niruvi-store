# Niruvi Store — Environment Configuration
# Base production URL used for canonical links, OpenGraph, sitemap.xml, and robots.txt
VITE_SITE_URL=https://niruvi-store.putinservai.workers.dev

# Cloudflare Worker Secrets (provision via `npx wrangler secret put <NAME>`; never expose to client)
GITHUB_TOKEN=ghp_example_dummy_token_for_github_releases_api
JWT_SECRET=example_dummy_jwt_secret_replace_in_wrangler

# Optional local development variables
PORT=3000
NODE_ENV=development

